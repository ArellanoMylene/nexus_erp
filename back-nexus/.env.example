PORT=5000
JWT_SECRET=generate_a_unique_random_secret_at_least_32_characters_long
FRONTEND_ORIGINS=http://localhost:5173,https://nexusbacocommunitycollege.com
AUTH_COOKIE_SAME_SITE=lax
# Set AUTH_COOKIE_SAME_SITE=none only when frontend and API are cross-site (requires HTTPS).
# AUTH_COOKIE_DOMAIN=.nexusbacocommunitycollege.com
GEMINI_API_KEY=

# DATABASE
DB_HOST=your_database_host
DB_NAME=your_database_name
DB_PASSWORD=your_database_password
DB_PORT=3306
DB_USER=your_database_user

# SMTP EMAIL CONFIGURATION (Hostinger Email)
# Create a mailbox in Hostinger, then use its full address and mailbox password below.
# SMTP_FROM is optional; when blank, mail uses SMTP_USER as its sender address.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
